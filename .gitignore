# ==========================================
# Broadlistening Project .gitignore
# ==========================================

# ==========================================
# LLM Models & Embeddings (Large Files)
# ==========================================
models/
embedding_models/
*.gguf
*.bin
*.safetensors
*.pth
*.pt

# ==========================================
# Sensitive Files & Configuration
# ==========================================
.env
.env.*
!.env.example
secrets.*
*.key
*.pem
credentials.*
config/secrets/

# ==========================================
# Docker & Container Data
# ==========================================
n8n_data/
forgejo_data/
qdrant_data/
postgres_data/
volumes/
*.log

# ==========================================
# Build Artifacts & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
node_modules/
.cache/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# IDE & Editor Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# ==========================================
# Logs & Temporary Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock
tmp/
temp/

# ==========================================
# Generated Data & Output
# ==========================================
web/data/issues.json
web/data/*.json
!web/data/.gitkeep
output/
results/

# ==========================================
# Backup Files
# ==========================================
*.bak
*.backup
*.old
*~
